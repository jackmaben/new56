{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": true,
  "redirects": [
    { "source": "/index.html", "has": [{ "type": "host", "value": "optimizetechstudio.com" }], "destination": "https://www.optimizetechstudio.com/", "statusCode": 301 },
    { "source": "/:path*", "has": [{ "type": "host", "value": "optimizetechstudio.com" }], "destination": "https://www.optimizetechstudio.com/:path*", "statusCode": 301 },
    { "source": "/saas-development.html", "destination": "/saas-technology-software-development.html", "permanent": true },
    { "source": "/author/juned-ghanchi-v2", "destination": "/author/juned-ghanchi/", "permanent": true },
    { "source": "/index.html", "destination": "https://www.optimizetechstudio.com/", "statusCode": 301 }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(.*)\\.css", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(.*)\\.js", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/favicon.ico", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(.*)\\.html", "headers": [
      { "key": "Cache-Control", "value": "public, max-age=600, s-maxage=3600, stale-while-revalidate=86400, stale-if-error=604800" },
      { "key": "Vary", "value": "Accept-Encoding" },
      { "key": "X-Robots-Tag", "value": "index, follow, max-image-preview:large, max-snippet:-1" },
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] },
    { "source": "/", "headers": [{ "key": "Cache-Control", "value": "public, max-age=600, s-maxage=3600, stale-while-revalidate=86400, stale-if-error=604800" }] },
    { "source": "/sitemap.xml", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] },
    { "source": "/robots.txt", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] }
  ]
}
